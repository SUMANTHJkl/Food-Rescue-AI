# App
APP_NAME="AI Food Waste Reduction & Redistribution Ecosystem"
APP_ENV=development
API_V1_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/foodwaste
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=foodwaste

# Redis cache
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Notifications (email/SMS provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Maps / Geo (location matching)
MAPS_API_KEY=

# Observability
LOG_LEVEL=INFO
